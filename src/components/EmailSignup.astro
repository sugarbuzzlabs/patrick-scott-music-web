---
import Button from './Button.astro';
import Input from './Input.astro';

/**
 * Email signup → Netlify Forms (same mechanism as the booking form).
 *
 * Addresses are collected under Forms → newsletter in the Netlify UI and
 * exported as CSV when you want to mail the list. No mailing-list provider
 * is involved, which means no automated unsubscribe handling — if the list
 * outgrows BCC, move to a real provider (Buttondown, ConvertKit) and point
 * this form's POST at their endpoint instead.
 */
const FORM_NAME = 'newsletter';
const field = 'email';
---

<section class="signup rule-top" aria-labelledby="signup-title">
  <div class="signup__inner">
    <h2 class="signup__title" id="signup-title">New shows, first.</h2>

    <form
      class="signup__form"
      name={FORM_NAME}
      method="post"
      data-netlify="true"
      data-netlify-honeypot="bot-field"
    >
      <input type="hidden" name="form-name" value={FORM_NAME} />
      <p class="visually-hidden" aria-hidden="true">
        <label>Leave this field empty<input type="text" name="bot-field" tabindex="-1" autocomplete="off" /></label>
      </p>
      <Input
        class="signup__field"
        type="email"
        name={field}
        placeholder="you@example.com"
        required
        autocomplete="email"
        aria-label="Email address"
      />
      <Button variant="solid" type="submit">Sign up</Button>
    </form>

    <p class="signup__status mono" data-signup-status hidden>You're on the list.</p>
    <p class="signup__error mono" data-signup-error hidden role="alert">That didn't go through. Try again.</p>
  </div>
</section>

<style>
  .signup {
    background: var(--surface-raised);
  }

  .signup__inner {
    max-width: 560px;
    margin: 0 auto;
    padding: var(--space-16) var(--space-5);
    text-align: center;
  }

  @media (min-width: 900px) {
    .signup__inner {
      padding: 72px var(--space-8);
    }
  }

  .signup__title {
    font-size: clamp(30px, 8vw, var(--text-3xl));
  }

  .signup__form {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: var(--space-7);
    text-align: left;
  }

  @media (min-width: 520px) {
    .signup__form {
      flex-direction: row;
      align-items: stretch;
    }

    .signup__form :global(.signup__field) {
      flex: 1;
    }
  }

  .signup__status {
    color: var(--text-accent);
    margin-top: var(--space-6);
  }

  .signup__error {
    color: var(--error);
    margin-top: var(--space-5);
    line-height: 1.7;
  }
</style>

<script>
  // Posts to Netlify Forms and swaps in the "You're on the list." state without
  // navigating. Netlify Forms only exists on a deploy, so localhost short-circuits
  // to the confirmation rather than a failed request.
  document.querySelectorAll<HTMLFormElement>('.signup__form').forEach((form) => {
    const wrap = form.parentElement;
    const status = wrap?.querySelector<HTMLElement>('[data-signup-status]');
    const error = wrap?.querySelector<HTMLElement>('[data-signup-error]');
    const onNetlify = !['localhost', '127.0.0.1'].includes(window.location.hostname);

    const confirm = () => {
      form.hidden = true;
      if (status) status.hidden = false;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      if (error) error.hidden = true;

      if (!onNetlify) {
        confirm();
        return;
      }

      try {
        const res = await fetch(window.location.pathname, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams(
            new FormData(form) as unknown as Record<string, string>,
          ).toString(),
        });
        if (!res.ok) throw new Error(String(res.status));
        confirm();
      } catch {
        if (error) error.hidden = false;
      }
    });
  });
</script>
