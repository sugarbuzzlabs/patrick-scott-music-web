---
/** Card — port of components/core/Card.jsx */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image?: ImageMetadata;
  imageAlt?: string;
  href?: string;
  padding?: number;
  class?: string;
}

const { image, imageAlt = '', href, padding = 24, class: className = '' } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag class={`card ${href ? 'card--link' : ''} ${className}`} href={href}>
  {
    image && (
      <Image
        class="card__img photo"
        src={image}
        alt={imageAlt}
        widths={[400, 800]}
        sizes="(min-width: 900px) 380px, 100vw"
        loading="lazy"
        decoding="async"
      />
    )
  }
  <div class="card__body" style={`padding:${padding}px`}>
    <slot />
  </div>
</Tag>

<style>
  .card {
    display: block;
    background: var(--surface-card);
    text-decoration: none;
    color: var(--text-primary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-none);
    overflow: hidden;
    transition: border-color var(--dur) var(--ease);
  }

  .card--link {
    cursor: pointer;
  }

  .card--link:hover {
    border-color: var(--border-strong);
    color: var(--text-primary);
  }

  .card__img {
    width: 100%;
    height: 180px;
  }
</style>
