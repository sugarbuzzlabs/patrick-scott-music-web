---
import site from '../data/site.json';
import links from '../data/links.json';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer__word">Patrick Scott</div>

    <nav class="footer__links" aria-label="Elsewhere">
      {
        links.platforms.map((p) => (
          <a class="footer__link mono" href={p.href} target="_blank" rel="noopener noreferrer">
            {p.name}
          </a>
        ))
      }
    </nav>

    <div class="footer__meta mono">
      <span>© {year} · {site.domain}</span>
      <a class="footer__mail" href={`mailto:${site.bookingEmail}`}>{site.bookingEmail}</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border-subtle);
    text-align: center;
    padding-block: var(--space-10);
  }

  .footer__word {
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 120%;
    text-transform: uppercase;
    font-size: 16px;
  }

  .footer__links {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin-top: var(--space-5);
  }

  .footer__link {
    color: var(--text-secondary);
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }

  .footer__link:hover {
    color: var(--accent);
  }

  .footer__meta {
    color: var(--text-muted);
    margin-top: var(--space-2);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .footer__mail {
    color: var(--text-muted);
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .footer__mail:hover {
    color: var(--accent);
  }
</style>
