---
import Button from './Button.astro';

interface Props {
  page?: 'home' | 'booking' | 'epk';
}
const { page } = Astro.props;

const items: Array<[string, string, string]> = [
  ['home', 'Home', '/'],
  ['booking', 'Booking', '/booking/'],
  ['epk', 'Press kit', '/press-kit/'],
];
---

<header class="nav">
  <div class="nav__inner container">
    <a class="nav__brand" href="/">
      <span class="nav__mark" aria-hidden="true">PS</span>
      <span class="nav__word">Patrick Scott</span>
    </a>

    <nav class="nav__links" aria-label="Primary">
      {
        items.map(([id, label, href]) => (
          <a
            class={`nav__link mono ${page === id ? 'nav__link--active' : ''}`}
            href={href}
            aria-current={page === id ? 'page' : undefined}
          >
            {label}
          </a>
        ))
      }
    </nav>

    <Button variant="solid" size="sm" class="nav__tip" data-dialog-open="tip-dialog">Tip</Button>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(12, 11, 10, 0.8);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border-subtle);
  }

  .nav__inner {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'brand tip'
      'links links';
    align-items: center;
    gap: var(--space-3) var(--space-5);
    padding-block: 10px;
  }

  .nav__brand {
    grid-area: brand;
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    min-height: 44px;
  }

  .nav__brand:hover {
    color: var(--text-primary);
  }

  .nav__mark {
    width: 34px;
    height: 34px;
    flex: none;
    border: 1.5px solid var(--paper);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-weight: 900;
    font-stretch: 120%;
    font-size: 14px;
  }

  .nav__word {
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 120%;
    text-transform: uppercase;
    font-size: 14px;
    letter-spacing: 0.02em;
  }

  .nav__links {
    grid-area: links;
    display: flex;
    align-items: center;
    gap: var(--space-6);
    border-top: 1px solid var(--border-subtle);
    padding-top: var(--space-1);
  }

  .nav__link {
    color: var(--text-secondary);
    text-decoration: none;
    border-bottom: 2px solid transparent;
    /* 44px target without visually fattening the thin bar */
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    transition:
      color var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }

  .nav__link:hover {
    color: var(--accent);
    border-bottom-color: var(--border-strong);
  }

  .nav__link--active {
    color: var(--text-accent);
    border-bottom-color: var(--accent);
  }

  .nav__tip {
    grid-area: tip;
  }

  /* Desktop: the mockup's single thin bar */
  @media (min-width: 800px) {
    .nav__inner {
      grid-template-columns: auto 1fr auto;
      grid-template-areas: 'brand links tip';
      gap: 28px;
      padding-block: 14px;
    }

    .nav__links {
      justify-content: flex-end;
      gap: 28px;
      border-top: 0;
      padding-top: 0;
    }
  }
</style>
